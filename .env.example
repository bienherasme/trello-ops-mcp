# Trello credentials — required by every tool except health_check. The
# server itself, and health_check, start and run fine without these set.
#
# Generate a read-only token at https://trello.com/app-key:
#   1. Copy your API Key from that page.
#   2. Click the "Token" link on that page to generate a personal token.
#      Use the read-only scope when prompted — this server never writes
#      to Trello, and a read-only token guarantees that at the credential
#      level too.
#
# Never commit your real .env file — it holds live credentials.
TRELLO_API_KEY=
TRELLO_TOKEN=

# Logging verbosity: debug | info | warn | error
LOG_LEVEL=info
